{
  "info": {
    "name": "QueueLess API",
    "description": "Every QueueLess endpoint. Run \"npm run import\" first, then use one of the Login requests: it saves the token in {{jwt}}, and every request sends it as a Bearer token. Requests that return an ID save it in a variable ({{menuItemId}}, {{orderId}}, {{ratingId}}, {{userId}}) so the next requests can use it.\n\nThe Stripe webhook (/webhook-checkout) can not be called from Postman because Stripe signs it. Use \"stripe listen --forward-to localhost:3000/webhook-checkout\" and pay with the test card 4242 4242 4242 4242.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "URL",
      "value": "http://localhost:3000"
    },
    {
      "key": "jwt",
      "value": ""
    },
    {
      "key": "menuItemId",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    },
    {
      "key": "pickupCode",
      "value": ""
    },
    {
      "key": "ratingId",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "resetToken",
      "value": ""
    }
  ],
  "item": [
