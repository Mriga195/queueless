                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{URL}}/api/v1/users/signup",
              "host": [
                "{{URL}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "signup"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"New Student\",\n  \"email\": \"new@queueless.dev\",\n  \"password\": \"test1234\",\n  \"passwordConfirm\": \"test1234\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const jwtValue = (() => { try { return pm.response.json().token; } catch (err) {} })();",
                  "if (jwtValue) pm.collectionVariables.set('jwt', jwtValue);"
                ]
              }
            }
          ]
        },
